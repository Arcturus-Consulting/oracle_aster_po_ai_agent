# Copy this file to .env and fill the values.

APP_HOST=127.0.0.1
APP_PORT=8000

GEMINI_API_KEY=gemini api key
GEMINI_MODEL=gemini-3.6-flash
ORACLE_BASE_URL=url
ORACLE_REST_VERSION=11.13.18.05
ORACLE_AUTH_MODE=basic
ORACLE_USERNAME=username
ORACLE_PASSWORD=pass
# OAuth only, if your Fusion instance uses OAuth instead of basic auth.
ORACLE_TOKEN_URL=
ORACLE_CLIENT_ID=
ORACLE_CLIENT_SECRET=
ORACLE_PROCUREMENT_BU=US1 Business Unit
ORACLE_TIMEOUT_SECONDS=30
ORACLE_PAGE_LIMIT=100
ORACLE_MAX_PAGES=10


# Optional email sending. If SMTP_HOST is empty, the Mail button returns a draft/mailto link only.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=username of smtp
SMTP_PASSWORD=password of smtp
SMTP_FROM=email id of from
SMTP_USE_TLS=true



UPSTASH_REDIS_REST_URL=upstash url
UPSTASH_REDIS_REST_TOKEN=upstash token

SCHEDULE_CACHE_TTL_SECONDS=300
PAGE_CACHE_TTL_SECONDS=300
DETAIL_CACHE_TTL_SECONDS=1800


APP_SESSION_TTL_SECONDS=1800
ORACLE_SESSION_TTL_SECONDS=1800

FIREBASE_WEB_API_KEY=web api key
FIREBASE_AUTH_DOMAIN=auth domain
FIREBASE_PROJECT_ID=project id
FIREBASE_STORAGE_BUCKET=storage bucket
FIREBASE_MESSAGING_SENDER_ID=sender id
FIREBASE_APP_ID=app id
OTP_TTL_SECONDS=60
OTP_MAX_ATTEMPTS=5